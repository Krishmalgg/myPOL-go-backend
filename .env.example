# Copy to .env (git-ignored) to make a bare `go run ./cmd/server` behave like
# scripts/run-dev.ps1. Variables already set in the environment win over this file.

# Must match NEXT_PUBLIC_CANVAS_REALTIME_PORT in my-app/.env.local.
HTTP_ADDR=:8081
CANVAS_JWT_PUBLIC_KEY_FILE=./keys/canvas-public.pem

# Any private-range address on the Next dev-server port, so a new LAN needs no edit.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.*.*:3000,http://10.*.*.*:3000,http://172.16.*.*:3000,http://172.17.*.*:3000,http://172.18.*.*:3000,http://172.19.*.*:3000,http://172.20.*.*:3000,http://172.21.*.*:3000,http://172.22.*.*:3000,http://172.23.*.*:3000,http://172.24.*.*:3000,http://172.25.*.*:3000,http://172.26.*.*:3000,http://172.27.*.*:3000,http://172.28.*.*:3000,http://172.29.*.*:3000,http://172.30.*.*:3000,http://172.31.*.*:3000
# WEBSOCKET_URL left unset: derived from each bootstrap request's Host.

# Shared with the .NET API, which keeps them in dotnet user-secrets
# (CanvasRealtime:Internal:CurrentKeyId / CurrentSecret). They must match it;
# if the API's secret is rotated, update it here too.
INTERNAL_HMAC_CURRENT_KEY_ID=
INTERNAL_HMAC_CURRENT_SECRET=

EPHEMERAL_BINARY_ENABLED=true
